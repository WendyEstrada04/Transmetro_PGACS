@startuml
!include comun.iuml
title Diagrama de Objetos — Transbordo en San Sebastián (Líneas 1 y 2) con alerta de refuerzo
object "guatemala : Municipio" as mun {
  codigoIso = "GT-0101"
  nombre = "Guatemala"
}
object "l1 : Linea" as l1 {
  codigoLinea = "L1"
  nombre = "San Sebastián – Centro Cívico"
  tarifa = 1.00
  rutaCircular = true
  distanciaTotalKm = 4.64
}
object "l2 : Linea" as l2 {
  codigoLinea = "L2"
  nombre = "Hipódromo del Norte – San Sebastián"
  tarifa = 1.00
  rutaCircular = true
  distanciaTotalKm = 3.50
}
object "horarioL2 : HorarioLinea" as h2 {
  tipoDia = "lunes_viernes"
  horaInicio = "05:30"
  horaFin = "20:00"
}
object "sanSebastian : Estacion" as ss {
  nombre = "San Sebastián"
  direccion = "3ª calle y 6ª avenida, zona 1"
  aforoMaximo = 300
  aforoActual = 480
}
object "le1 : LineaEstacion" as le1 {
  ordenParada = 1
  distanciaPreviaKm = 0.62
}
object "le2 : LineaEstacion" as le2 {
  ordenParada = 1
  distanciaPreviaKm = 0.60
}
object "simeonCanas : Estacion" as sc {
  nombre = "Simeón Cañas"
  direccion = "Avenida Simeón Cañas y 7ª calle, zona 2"
  aforoMaximo = 200
}
object "le3 : LineaEstacion" as le3 {
  ordenParada = 2
  distanciaPreviaKm = 1.20
}
object "accesoNorte : Acceso" as ac {
  ubicacionFisica = "Acceso Norte"
}
object "molinete1 : Molinete" as mo {
  ipAddress = "10.10.1.11"
  estadoOperativo = "activo"
}
object "guardia1 : Seguridad" as gu {
  numeroPlacaAsignada = "SEG-001"
}
object "operador1 : Operador" as op {
  nivelEstudios = "Universitario"
}
object "alerta1 : AlertaSistema" as al {
  tipoAlerta = "refuerzo_bus"
  descripcion = "Superó el 150 % (480/300)"
  estado = "abierta"
}
object "tm001 : Bus" as bus {
  placa = "TM-001"
  capacidadMaxima = 90
  ocupacionActualPct = 18
  estadoLogico = "en_ruta"
}
object "b01 : Parqueo" as pq {
  codigoBahia = "B-01"
}
object "tarjeta1 : Tarjeta" as tj {
  tipoTarjeta = "ciudadana"
  saldo = 20.00
  viajesGratisRestantes = 4
}
object "pase1 : TransaccionPago" as tx {
  metodoPago = "tarjeta_ciudadana"
  monto = 0.00
  viajeGratis = true
}
mun -- l1
mun -- l2
l2 -- h2
l1 -- le1
le1 -- ss
l2 -- le2
le2 -- ss
l2 -- le3
le3 -- sc
ss -- ac
ac -- mo
ac -- gu
ss -- op
ss -- al
l1 -- bus
bus -- pq
pq -- ss
mo -- tx
tj -- tx
note right of bus
  ocupación 18 % < 25 % →
  espera 5 min extra en cada estación
end note
@enduml
