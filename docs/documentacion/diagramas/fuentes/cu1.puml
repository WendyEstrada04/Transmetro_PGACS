@startuml
!include comun.iuml
left to right direction
title Diagrama de Casos de Uso (1/2) — Administración (Sistema de Control Transmetro)
actor "Administrador /\nMunicipalidad" as Admin
actor "Sistema\n(automático)" as Sis
rectangle "Sistema de Control Transmetro" {
  package "Infraestructura y rutas" {
    usecase "Administrar municipios" as U1
    usecase "Administrar líneas\n(tarifa, color, estado)" as U2
    usecase "Definir recorrido\n(estaciones en orden y distancias)" as U3
    usecase "Configurar horarios\nde servicio" as U4
    usecase "Importar mapa oficial (KML)\ny trazar ruta por las calles" as U5
    usecase "Administrar estaciones,\naccesos y molinetes" as U6
    usecase "Administrar parqueos" as U7
    usecase "Administrar buses y\nasignarlos a una línea" as U8
    usecase "Cambiar bus de parqueo" as U9
  }
  package "Personal" {
    usecase "Administrar pilotos\n(historial educativo, residencia,\ncomunicación)" as P1
    usecase "Administrar personal de\nseguridad por acceso" as P2
    usecase "Administrar operadores\nde estación" as P3
  }
  package "Tarjeta Ciudadana" {
    usecase "Emitir tarjeta\n(Q20 + 5 viajes gratis)" as T1
    usecase "Recargar tarjeta (Q5–Q200)\ny cambiar estado" as T2
  }
  package "Consultas y reportes" {
    usecase "Ver mapa de rutas" as R0
    usecase "Generar reportes de estaciones,\nlíneas y buses asignados\n(CSV / PDF + consulta SQL)" as R1
  }
  package "Reglas automáticas (base de datos)" {
    usecase "Validar flota n–2n\npor línea" as S1
    usecase "Validar mínimo 2 accesos\ny 1 guardia por acceso" as S2
    usecase "Recalcular distancia\ntotal de la línea" as S3
    usecase "Registrar bitácora\nde auditoría" as S4
  }
}
Admin --> U1
Admin --> U2
Admin --> U3
Admin --> U4
Admin --> U5
Admin --> U6
Admin --> U7
Admin --> U8
Admin --> U9
Admin --> P1
Admin --> P2
Admin --> P3
Admin --> T1
Admin --> T2
Admin --> R0
Admin --> R1
U8 ..> S1 : <<include>>
U6 ..> S2 : <<include>>
P2 ..> S2 : <<include>>
U3 ..> S3 : <<include>>
U5 ..> S4 : <<include>>
S1 <-- Sis
S2 <-- Sis
S3 <-- Sis
S4 <-- Sis
@enduml
