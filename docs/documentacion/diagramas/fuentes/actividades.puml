@startuml
!include comun.iuml
skinparam ActivityFontSize 13
skinparam ActivityDiamondFontSize 12
skinparam SwimlaneTitleFontSize 15
skinparam ArrowFontSize 12
skinparam ActivityBackgroundColor #EEF4FB
skinparam ActivityBorderColor #2F5597
skinparam ActivityDiamondBackgroundColor #FFF7E6
skinparam ActivityDiamondBorderColor #B7791F
title Diagrama de Actividades — Asignación de un bus a una línea
|Administrador|
start
:Seleccionar bus disponible;
:Seleccionar línea destino;
|Sistema (Backend)|
if (¿El bus ya está asignado\na otra línea activa?) then (sí)
  :Rechazar operación:\n"bus ya asignado";
  |Administrador|
  :Ver mensaje de error;
  stop
else (no)
  |Sistema (Backend)|
  :Calcular buses actuales\nde la línea y su límite\n(2 × número de paradas);
  if (¿Se alcanzó el máximo\npermitido?) then (sí)
    :Generar advertencia:\n"límite de flota alcanzado";
    |Administrador|
    :Ver advertencia y\ncancelar o elegir otra línea;
    stop
  else (no)
    |Sistema (Backend)|
    :Asignar bus a la línea\n(UPDATE buses.id_linea_asignada);
    if (¿El bus ya tiene un\nparqueo asignado?) then (no)
      |Administrador|
      :Seleccionar parqueo disponible\nen la estación de origen;
      |Sistema (Backend)|
      :Ejecutar sp_cambiar_parqueo_bus\n(transacción atómica);
    else (sí)
      :Mantener parqueo actual;
    endif
    :Registrar operación en\nbitácora de auditoría;
    |Administrador|
    :Ver confirmación de\nasignación exitosa;
    stop
  endif
endif
@enduml
