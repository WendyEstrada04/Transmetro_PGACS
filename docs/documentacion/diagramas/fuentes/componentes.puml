@startuml
!include comun.iuml
title Diagrama de Componentes — Arquitectura Laravel en Render + PostgreSQL en Supabase
node "PC de trabajo de cada estación /\nequipo del administrador" as PC {
  component "Navegador web\n(Chrome, Edge, Firefox)" as Nav
}
node "Render — Web Service (Docker)" as Render {
  component "Laravel 13 (PHP 8.4)" as Laravel {
    component "Autenticación y roles\n(LoginController, VerificarRol)" as Auth
    component "Módulo administrativo\n(municipios, líneas, estaciones,\nbuses, parqueos, personal, tarjetas)" as Admin
    component "Panel del operador\n(aforo, alertas, pases)" as Oper
    component "Servicio CobroPasaje" as Cobro
    component "Mapa y editor de trazo\n(ImportadorKml, ExportadorTrazos)" as Mapa
    component "Reportes (SQL directo)" as Rep
    component "Vistas Blade + Tailwind" as Vistas
  }
}
node "Supabase (AWS us-east-1)" as Supa {
  database "PostgreSQL\n20 tablas + users\n5 triggers + 1 procedimiento\nRLS activado" as DB
}
cloud "Servicios externos (desde el navegador)" as Ext {
  component "Teselas OpenStreetMap\n+ Leaflet" as OSM
  component "OSRM (ajuste a calles)" as OSRM
}
node "GitHub" as GH {
  component "Repositorio Transmetro_PGACS" as Repo
  component "GitHub Actions\n(Pint + 146 pruebas Pest)" as CI
}
Nav --> Vistas : HTTPS / TLS
Vistas --> Auth
Vistas --> Admin
Vistas --> Oper
Vistas --> Mapa
Vistas --> Rep
Oper --> Cobro
Auth --> DB : PDO pgsql / SSL\n(session pooler 5432)
Admin --> DB
Cobro --> DB
Mapa --> DB
Rep --> DB
Nav ..> OSM : HTTPS
Nav ..> OSRM : HTTPS
Repo --> CI
Repo ..> Render : despliegue automático
note bottom of DB
  Ningún equipo de estación se conecta directamente
  a la base de datos: todo pasa por Laravel (validación,
  permisos y reglas de negocio). RLS bloquea la API pública
  de Supabase.
end note
@enduml
