digraph S {
graph [rankdir=TB, nodesep=0.25, ranksep=0.25, fontname="Helvetica", bgcolor="white", pad=0.3, label=<<b>Stack tecnológico — Sistema de Control Transmetro</b>>, labelloc=t, fontsize=18];
node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, width=2.2, height=0.75, color="#9FBFB1"];
edge [style=invis];
subgraph cluster_m { label=<<b>Metodología</b>>; style="rounded,filled"; fillcolor="#FFF7E6"; color="#B7791F"; fontname="Helvetica";
  scrum [label=<<b>Scrum</b><br/><font point-size="10">sprints, backlog, revisión</font>>, fillcolor="#FDEBC8"]; }
subgraph cluster_p { label=<<b>Presentación (navegador de la PC de estación)</b>>; style="rounded,filled"; fillcolor="#EEF4FB"; color="#2F5597"; fontname="Helvetica";
  blade [label=<<b>Blade</b><br/><font point-size="10">vistas del servidor</font>>, fillcolor="#DCE7F5"];
  tw [label=<<b>Tailwind CSS 4</b><br/><font point-size="10">+ Vite 8</font>>, fillcolor="#DCE7F5"];
  lf [label=<<b>Leaflet 1.9</b><br/><font point-size="10">OpenStreetMap + OSRM</font>>, fillcolor="#DCE7F5"]; }
subgraph cluster_a { label=<<b>Aplicación (Render)</b>>; style="rounded,filled"; fillcolor="#EAF5EF"; color="#0F3B2E"; fontname="Helvetica";
  php [label=<<b>PHP 8.4</b><br/><font point-size="10">lenguaje</font>>, fillcolor="#CFE8DA"];
  lar [label=<<b>Laravel 13</b><br/><font point-size="10">MVC, Eloquent, roles</font>>, fillcolor="#CFE8DA"];
  pest [label=<<b>Pest 5 + Pint</b><br/><font point-size="10">146 pruebas, estilo</font>>, fillcolor="#CFE8DA"]; }
subgraph cluster_d { label=<<b>Datos (Supabase)</b>>; style="rounded,filled"; fillcolor="#F3EEF8"; color="#5B3F87"; fontname="Helvetica";
  pg [label=<<b>PostgreSQL</b><br/><font point-size="10">triggers, PL/pgSQL, RLS</font>>, fillcolor="#E2D7F0"];
  db [label=<<b>DBeaver</b><br/><font point-size="10">diseño y consultas</font>>, fillcolor="#E2D7F0"]; }
subgraph cluster_t { label=<<b>Desarrollo y calidad</b>>; style="rounded,filled"; fillcolor="#F4F4F4"; color="#666666"; fontname="Helvetica";
  vs [label=<<b>VS Code</b><br/><font point-size="10">IDE</font>>, fillcolor="#E6E6E6"];
  gh [label=<<b>GitHub</b><br/><font point-size="10">repositorio</font>>, fillcolor="#E6E6E6"];
  ga [label=<<b>GitHub Actions</b><br/><font point-size="10">integración continua</font>>, fillcolor="#E6E6E6"]; }
scrum -> blade; blade -> php; php -> pg; pg -> vs;
tw -> lar; lar -> db; lf -> pest; db -> gh; pest -> ga;
}
