digraph ER {
graph [rankdir=LR, splines=spline, nodesep=0.35, ranksep=1.4, fontname="Helvetica", bgcolor="white", pad=0.3];
node [shape=plaintext, fontname="Helvetica", fontsize=10];
edge [color="#5b6b65", penwidth=1.1, dir=both, arrowsize=0.8];
