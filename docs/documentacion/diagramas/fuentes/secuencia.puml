@startuml
!include comun.iuml
title Diagrama de Secuencia — Pase con Tarjeta Ciudadana y alerta automática de refuerzo
actor Pasajero
actor "Operador de\nestación" as Op
participant "Panel del operador\n(navegador)" as UI
participant "EstacionController\n(Laravel, Render)" as C
participant "CobroPasaje" as S
database "PostgreSQL\n(Supabase)" as DB
Pasajero -> Op : presenta Tarjeta Ciudadana en el molinete
Op -> UI : elige acceso, línea, método y número de tarjeta
UI -> C : POST /operador/pases (HTTPS + token CSRF)
C -> C : valida rol operador y que el acceso\ny la línea sean de su estación
C -> S : cobrar(molinete, línea, "tarjeta_ciudadana", número)
activate S
S -> DB : BEGIN; SELECT tarjeta ... FOR UPDATE
DB --> S : tarjeta (estado, saldo, viajes gratis)
alt tarjeta bloqueada / no existe
  S --> C : error de validación
  C --> UI : mensaje claro al operador
else viajes gratis > 0
  S -> DB : UPDATE tarjetas SET viajes_gratis_restantes - 1
  S -> DB : INSERT transacciones_pago (monto 0, viaje_gratis = true)
else saldo >= tarifa de la línea
  S -> DB : UPDATE tarjetas SET saldo = saldo - tarifa
  S -> DB : INSERT transacciones_pago (monto = tarifa)
else saldo insuficiente
  S --> C : "Saldo insuficiente, recargue Q5 a Q200"
end
S -> DB : COMMIT
deactivate S
C --> UI : "Pase registrado"
== Más tarde: el operador actualiza el aforo de la estación ==
Op -> UI : aforo actual = 480 personas
UI -> C : POST /operador/aforo
C -> DB : UPDATE estaciones SET aforo_actual = 480
DB -> DB : trg_estaciones_alerta_aforo:\n¿480 >= 1.5 × 300?
alt supera el 150 % del aforo
  DB -> DB : INSERT alertas_sistema (refuerzo_bus, abierta)
end
C -> DB : INSERT bitacora_auditoria (antes / después)
C --> UI : panel muestra la alerta abierta
Op -> UI : "Atender alerta" (solicita bus de refuerzo)
UI -> C : POST /operador/alertas/{id}/atender
C -> DB : UPDATE alertas_sistema SET estado = 'atendida', fecha_cierre = now()
@enduml
